<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-padding: 30; -fx-background-color: #ecf0f1;"
      VBox.vgrow="ALWAYS" xmlns:fx="http://javafx.com/fxml"
      xmlns="http://javafx.com/javafx/17">


    <Label text="Course Management"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>

    <TableView fx:id="courseTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="courseID" text="Course ID" prefWidth="300"/>
            <TableColumn fx:id="title" text="Course Name" prefWidth="300"/>
            <TableColumn fx:id="numberOfCredits" text="Credits" prefWidth="500"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="courseIdInput" promptText="Course ID" prefWidth="150"/>
        <TextField fx:id="courseTitleInput" promptText="Course Title" prefWidth="250"/>
        <TextField fx:id="courseCreditsInput" promptText ="Credits" prefWidth="80"/>
        <Button text="Add Course" onAction="#handleAddCourse" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Delete Selected" onAction="#handleDeleteCourse" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
    </HBox>

    <Label text="Showing all active courses for the current academic year."
           style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
</VBox>